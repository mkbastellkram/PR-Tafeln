    </div>
  </div>
  <div class="controls" id="controls">
    <div class="ribbon-handle" id="ribbonHandle" aria-hidden="true"></div>
    <div class="controls-row">
      <button class="txtbtn" id="btnGpx" onclick="toggleGpx()">GPX anzeigen</button>
      <button class="txtbtn" id="btnAdjust" onclick="toggleAdjust()">GPX ausrichten</button>
      <button class="txtbtn" onclick="resetGpx()">Reset</button>
      <button class="txtbtn" onclick="saveGpx()">Speichern</button>
      <label>Transparenz <input type="range" min="15" max="100" value="82" oninput="setGpxOpacity(this.value)"></label>
    </div>
    <div class="controls-row adjust-row" aria-label="GPX Feinjustierung">
      <button onclick="nudgeGpx(0,-18)" title="hoch">↑</button>
      <button onclick="nudgeGpx(-18,0)" title="links">←</button>
      <button onclick="nudgeGpx(18,0)" title="rechts">→</button>
      <button onclick="nudgeGpx(0,18)" title="runter">↓</button>
      <button onclick="scaleGpx(.97)" title="kleiner">−</button>
      <button onclick="scaleGpx(1.03)" title="größer">+</button>
      <button onclick="rotateGpx(-1.5)" title="links drehen">↶</button>
      <button onclick="rotateGpx(1.5)" title="rechts drehen">↷</button>
    </div>
    <div class="mode-note" id="modeNote">Ribbon nach oben wischen/eintippen. GPX-Layer ist zunächst ausgeblendet.</div>
  </div>
</div>

<script>
const MAP_W=4480, MAP_H=3295;
const stage=document.getElementById('stage'), viewer=document.getElementById('viewer'), mapLayer=document.getElementById('mapLayer');
const fullMap=document.getElementById('fullMap'), viewerTitle=document.getElementById('viewerTitle'), zoomChip=document.getElementById('zoomChip');
const gpxSvg=document.getElementById('gpxSvg'), gpxGroup=document.getElementById('gpxGroup');
const btnGpx=document.getElementById('btnGpx'), btnAdjust=document.getElementById('btnAdjust'), modeNote=document.getElementById('modeNote'), controls=document.getElementById('controls'), ribbonHandle=document.getElementById('ribbonHandle');
const mapSrc=fullMap.src;
const originalImg=document.querySelector('#originalPreview img');
let imgW=MAP_W, imgH=MAP_H, scale=1, fitScale=1, x=0, y=0, isOpen=false, currentMode='map';
let gpxVisible=false, adjustMode=false, gpx={x:0,y:0,scale:1,rot:0,opacity:.82};
let touches=new Map(), lastDist=0, lastAngle=0, startScale=1, gpxStart={...gpx};
let lastTapPreview=0, lastTapStage=0;
let edgeStart=null, ribbonStart=null;

function setViewerImage(src,title,mode){
  currentMode=mode;
  viewerTitle.textContent=title;
  fullMap.src=src;
  gpxSvg.style.display=(mode==='map' && gpxVisible)?'block':'none';
  controls.style.display=(mode==='map')?'grid':'none';
  if(mode!=='map'){ adjustMode=false; }
}
function updateImageSizeThenFit(){
  // naturalWidth is reliable for data URIs after load. Fallback to known map size.
  imgW=fullMap.naturalWidth || (currentMode==='map'?MAP_W:fullMap.width||MAP_W);
  imgH=fullMap.naturalHeight || (currentMode==='map'?MAP_H:fullMap.height||MAP_H);
  fullMap.style.width=imgW+'px'; fullMap.style.height=imgH+'px';
  fitHeight();
}
function updateMap(){
  mapLayer.style.transform=`translate(${x}px, ${y}px) scale(${scale})`;
  if(scale < fitScale*1.04) zoomChip.textContent='Höhe';
  else if(Math.abs(scale-1)<.05) zoomChip.textContent='1:1';
  else zoomChip.textContent=Math.round(scale*100)+' %';
}
function clampPan(){
  const vw=stage.clientWidth, vh=stage.clientHeight, sw=imgW*scale, sh=imgH*scale;
  const margin=80;
  if(sw <= vw){ x=(vw-sw)/2; } else { x=Math.min(margin, Math.max(vw-sw-margin, x)); }
  if(sh <= vh){ y=(vh-sh)/2; } else { y=Math.min(margin, Math.max(vh-sh-margin, y)); }
}
function fitHeight(){
  const vw=stage.clientWidth, vh=stage.clientHeight;
  fitScale=vh/imgH;
  scale=fitScale;
  x=(vw-imgW*scale)/2;
  y=(vh-imgH*scale)/2;
  clampPan(); updateMap();
}
function zoomTo(target,cx=stage.clientWidth/2,cy=stage.clientHeight/2){
  const old=scale, mx=(cx-x)/old, my=(cy-y)/old;
  const maxZoom=Math.max(1, Math.min(12, 1.35)); // allow native 1:1 plus small reserve; no 200% ceiling
  scale=Math.max(fitScale, Math.min(target, maxZoom));
  x=cx-mx*scale; y=cy-my*scale; clampPan(); updateMap();
}
function toggleNative(e){
  const cx=e?.clientX||stage.clientWidth/2, cy=e?.clientY||stage.clientHeight/2;
  if(scale < .92) zoomTo(1,cx,cy); else fitHeight();
}
function openMapViewer(){ setViewerImage(mapSrc,'PR9 Karte','map'); viewer.classList.add('open'); isOpen=true; fullMap.onload=updateImageSizeThenFit; setTimeout(updateImageSizeThenFit,30); }
function openOriginalViewer(){ setViewerImage(originalImg.src,'PR9 Originaltafel','original'); viewer.classList.add('open'); isOpen=true; fullMap.onload=updateImageSizeThenFit; setTimeout(updateImageSizeThenFit,30); }
function closeViewer(){ viewer.classList.remove('open'); isOpen=false; controls?.classList.remove('open'); }

document.getElementById('mapPreview').addEventListener('dblclick', openMapViewer);
document.getElementById('mapPreview').addEventListener('click', e=>{ if(e.target.classList.contains('map-hint')) openMapViewer(); });
document.getElementById('mapPreview').addEventListener('touchend', e=>{ const now=Date.now(); if(now-lastTapPreview<320){ e.preventDefault(); openMapViewer(); } lastTapPreview=now; }, {passive:false});
document.getElementById('originalPreview')?.addEventListener('click', openOriginalViewer);

stage.addEventListener('dblclick', e=>{ e.preventDefault(); toggleNative(e); });
stage.addEventListener('touchend', e=>{ const now=Date.now(); if(touches.size===0 && now-lastTapStage<300){ e.preventDefault(); toggleNative(e.changedTouches[0]); } lastTapStage=now; }, {passive:false});

function dist(a,b){ return Math.hypot(a.clientX-b.clientX,a.clientY-b.clientY); }
function angle(a,b){ return Math.atan2(b.clientY-a.clientY,b.clientX-a.clientX)*180/Math.PI; }
function center(a,b){ return {x:(a.clientX+b.clientX)/2,y:(a.clientY+b.clientY)/2}; }

stage.addEventListener('touchstart', e=>{
  e.preventDefault();
  for(const t of e.changedTouches) touches.set(t.identifier,t);
  const arr=[...touches.values()];
  if(arr.length===1){
    const t=arr[0];
    window._oneStart={sx:t.clientX,sy:t.clientY,x:x,y:y,gpxx:gpx.x,gpxy:gpx.y};
    edgeStart={sx:t.clientX,sy:t.clientY,edge:(t.clientX<22?'left':(t.clientX>stage.clientWidth-22?'right':(t.clientY<26?'top':null)))};
  }
  if(arr.length>=2){
    window._oneStart=null; edgeStart=null;
    lastDist=dist(arr[0],arr[1]); lastAngle=angle(arr[0],arr[1]); startScale=scale; gpxStart={...gpx};
  }
}, {passive:false});

stage.addEventListener('touchmove', e=>{
  e.preventDefault();
  for(const t of e.changedTouches) touches.set(t.identifier,t);
  const arr=[...touches.values()];
  if(arr.length===1){
    const t=arr[0], s=window._oneStart; if(!s) return;
    const dx=t.clientX-s.sx, dy=t.clientY-s.sy;
    // stable edge gestures for closing: left/right edge horizontal swipe or top-edge downward swipe
    if(edgeStart?.edge==='left' && dx>80){ closeViewer(); return; }
    if(edgeStart?.edge==='right' && dx<-80){ closeViewer(); return; }
    if(edgeStart?.edge==='top' && dy>90){ closeViewer(); return; }
    if(adjustMode && currentMode==='map'){
      gpx.x=s.gpxx + dx/scale; gpx.y=s.gpxy + dy/scale; applyGpx();
    } else {
      x=s.x+dx; y=s.y+dy; clampPan(); updateMap();
    }
  }
  if(arr.length>=2){
    window._oneStart=null;
    const nd=dist(arr[0],arr[1]), na=angle(arr[0],arr[1]), c=center(arr[0],arr[1]);
    const factor=nd/lastDist;
    if(adjustMode && currentMode==='map'){
      gpx.scale=gpxStart.scale*factor; gpx.rot=gpxStart.rot+(na-lastAngle); applyGpx();
    } else {
      zoomTo(startScale*factor,c.x,c.y);
    }
  }
}, {passive:false});

stage.addEventListener('touchend', e=>{ for(const t of e.changedTouches) touches.delete(t.identifier); if(touches.size===0){ window._oneStart=null; edgeStart=null; } }, {passive:false});

// Ribbon show/hide: tap handle or vertical swipe on handle/control surface
ribbonHandle?.addEventListener('click',()=>controls.classList.toggle('open'));
controls?.addEventListener('touchstart',e=>{ const t=e.touches[0]; ribbonStart={y:t.clientY, open:controls.classList.contains('open')}; }, {passive:true});
controls?.addEventListener('touchmove',e=>{ if(!ribbonStart) return; const dy=e.touches[0].clientY-ribbonStart.y; if(dy<-28) controls.classList.add('open'); if(dy>34) controls.classList.remove('open'); }, {passive:true});

function toggleGpx(){
  if(currentMode!=='map') return;
  gpxVisible=!gpxVisible; gpxSvg.style.display=gpxVisible?'block':'none'; btnGpx.classList.toggle('active',gpxVisible);
  btnGpx.textContent=gpxVisible?'GPX ausblenden':'GPX anzeigen';
}
function toggleAdjust(){
  if(currentMode!=='map') return;
  adjustMode=!adjustMode; if(adjustMode && !gpxVisible) toggleGpx();
  btnAdjust.classList.toggle('active',adjustMode);
  modeNote.textContent=adjustMode?'Ausrichtmodus: Karte bleibt fix. GPX-Layer ziehen oder mit der Symbolzeile feinjustieren.':'Kartenmodus: Karte zoomen/verschieben. GPX bewegt sich mit der Karte.';
}
function applyGpx(){
  gpxGroup.setAttribute('transform',`translate(${gpx.x} ${gpx.y}) scale(${gpx.scale}) rotate(${gpx.rot} 2240.0 1647.5)`);
  gpxSvg.style.opacity=gpx.opacity;
}
function setGpxOpacity(v){ gpx.opacity=v/100; applyGpx(); }
function nudgeGpx(dx,dy){ gpx.x+=dx; gpx.y+=dy; applyGpx(); }
function scaleGpx(f){ gpx.scale*=f; applyGpx(); }
function rotateGpx(r){ gpx.rot+=r; applyGpx(); }
function resetGpx(){ gpx={x:0,y:0,scale:1,rot:0,opacity:.82}; applyGpx(); }
function saveGpx(){
  const txt=JSON.stringify({gpx_overlay:{transform:gpx,status:'manual_visual_alignment',note:'Manuell auf schematische IFCN-Karte ausgerichtet; keine Navigation.'}}, null, 2);
  navigator.clipboard?.writeText(txt);
  modeNote.textContent='Transformationswerte in die Zwischenablage kopiert.';
}
gpxSvg.style.display='none'; applyGpx();

function openInfo(){ document.getElementById('backdrop').classList.add('open'); document.getElementById('infoSheet').classList.add('open'); }
function closeSheets(){ document.getElementById('backdrop').classList.remove('open'); document.getElementById('infoSheet').classList.remove('open'); }
function openProCiv(){
  const fallback='https://apps.apple.com/de/app/prociv-madeira/id1208156465';
  const t=Date.now(); window.location.href='procivmadeira://';
  setTimeout(()=>{ if(Date.now()-t<1600) window.location.href=fallback; },900);
}
window.addEventListener('resize', ()=>{ if(isOpen) updateImageSizeThenFit(); });
</script>
</body>
</html>
